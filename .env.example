# Copy to .env.local for development. In development, missing password hashes fall back to the
# documented development passwords. In production every value below is required.

# Postgres (Supabase, Mumbai region). Leave unset in development to use the embedded database in .data/
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Fixed staff accounts. Generate with: pnpm credentials
ANNAM_NUTRITIONIST_PASSWORD_HASH=
ANNAM_CLINIC_PASSWORD_HASH=
ANNAM_ADMIN_PASSWORD_HASH=
ANNAM_ADMIN_TOTP_SECRET=

# Retention job (Vercel Cron). Days after withdrawal or approval before records are deleted.
# Leave empty until set with legal advice: the job then does nothing.
CRON_SECRET=
ANNAM_RETENTION_DAYS=

# Sample patients: on by default in development, off in production.
# ANNAM_SEED_SAMPLES=false
